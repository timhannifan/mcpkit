# OpenWebUI configuration
WEBUI_SECRET_KEY=your-secret-key-change-this

# Server configuration (for docker-compose.prod.yaml)
# Use your EC2 public IP address
SERVER_IP=YOUR_EC2_IP_ADDRESS
WEBUI_BASE_URL=http://YOUR_EC2_IP_ADDRESS
WEBUI_URL=http://YOUR_EC2_IP_ADDRESS
WEBUI_CSRF_TRUSTED_ORIGINS=http://YOUR_EC2_IP_ADDRESS
CORS_ALLOW_ORIGINS=http://YOUR_EC2_IP_ADDRESS

# MCPO API Key (for OpenAPI proxy)
# Default: dev-api-key (for local dev). Change to a secure key for production.
MCPO_API_KEY=dev-api-key

# Neo4j (for mcp-server and make seed-db)
# Defaults work for local dev. Set NEO4J_PASSWORD (and optionally others) in .env for production.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
